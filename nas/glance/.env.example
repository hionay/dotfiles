# Pass to glance with `env_file: .env` in its compose service.

# Name the browser uses for links and images (no scheme, no port).
NAS_HOST=hio-nas
# NAS LAN IP, used by glance itself to reach plex and dockhand.
NAS_IP=192.168.1.42
# Just the city, or "City, Country" with the country as Open-Meteo spells it.
WEATHER_LOCATION=City

ADGUARD_URL=http://192.168.1.153
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Dockhand: Settings > API tokens. The env ID is the number in the environment's URL.
DOCKHAND_API_TOKEN=
DOCKHAND_ENV_ID=1

# *arr: Settings > General > Security > API Key
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=

# https://support.plex.tv/articles/204059436
PLEX_TOKEN=
# Tautulli: Settings > Web Interface > API
TAUTULLI_API_KEY=
# http://NAS_HOST:8181/api/v2?apikey=TAUTULLI_API_KEY&cmd=get_server_id&hostname=NAS_HOST&port=32400 -> "identifier"
PLEX_SERVER_ID=

# Miniflux: Settings > API Keys
MINIFLUX_API_KEY=

# Cloudflare: dash > Manage account > Account API tokens, permission Account > Cloudflare Tunnel > Read.
# Account ID is in the dashboard URL; tunnel ID is under Zero Trust > Networks > Tunnels.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
